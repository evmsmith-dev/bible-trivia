{
  "name": "bible-trivia",
  "private": true,
  "version": "1.9.108",
  "description": "Bible trivia static app",
  "scripts": {
    "serve": "node scripts/serve.mjs . 8080",
    "validate:questions": "node scripts/validate-questions.mjs",
    "test": "npm run validate:questions && npm run test:e2e",
    "test:e2e": "playwright test",
    "build:pages:py": "py scripts/minify_safe.py --source index.source.html --minify-js --minify-external-css --minify-external-js --output index.html",
    "publish:prep:py": "py scripts/publish_prep.py"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}

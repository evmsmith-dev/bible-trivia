{
  "name": "bible-trivia",
  "private": true,
  "version": "2.0.0",
  "description": "Bible trivia progressive web app",
  "scripts": {
    "start": "node scripts/serve.mjs . 8080",
    "build": "node scripts/build.mjs",
    "preview": "npm run build && node scripts/serve.mjs dist 8080",
    "validate:questions": "node scripts/validate-questions.mjs",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run validate:questions && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "^0.25.10"
  },
  "type": "module"
}
